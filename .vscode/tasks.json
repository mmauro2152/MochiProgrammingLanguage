{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build project",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/FuncDir.cpp {workspaceFolder}/src/VarTable.cpp {workspaceFolder}/src/MochiLexer/MochiLexer.yy.cpp ${workspaceFolder}/src/MochiParser/MochiParser.tab.cpp ${workspaceFolder}/src/main.cpp",
                "-o",
                "mochi.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}